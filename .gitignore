# Python cache
__pycache__/
*.py[cod]

# Build artifacts
build/
Output/
output/
release_tooling_nuitka/output/
release_tooling_nuitka/dist/
release_tool/dist/

# Keep the packaged executable, ignore the rest of dist
dist/*
!dist/.gitkeep

# Generated benchmark reports
benchmarks/results/*
!benchmarks/results/benchmark_summary.csv
!benchmarks/results/benchmark_summary.png

# Local benchmark source captures
benchmarks/data_sources/

# Local database workspace
database/
xfoil/
database/_local/
airfoils_database.db

# Local release configuration and secrets
*.local
*.local.*
Action/installer_upload.local.ps1
Action/*.local.ps1
release_tooling_nuitka/**/*.local.ps1
release_tooling/**/*.local.ps1
!Action/*.local.ps1.template
!release_tooling_nuitka/**/*.local.ps1.template
!release_tooling/**/*.local.ps1.template

# Code signing material and private keys
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.spc
*.pvk
*.sig
*.signtool.log
*.timestamp

# Installer / binary release payloads
*.exe
*.msi
*.zip
*.7z
*.tar
*.tar.gz
